# Copy to .env. Secrets are read by the server only.
PORT=4300
STUDIO_DATA_DIR=./data
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
PYTHON_EXECUTABLE=python
WHISPER_MODEL=small.en
# WHISPER_DEVICE=auto
# Windows x64 uses the media binaries shipped with Remotion by default.
# Override these only if using your own FFmpeg installation.
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
# Chrome/Edge is detected on Windows. Override if installed elsewhere.
# REMOTION_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_KEY_BACKUP=
PEXELS_API_KEY=
PIXABAY_API_KEY=
RUNWARE_API_KEY=
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_BACKUP_PROVIDER=serper
WEB_SEARCH_TIMEOUT_MS=12000
